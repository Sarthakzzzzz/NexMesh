# Python environments and package manager caches
.gitignore
.venv/
**/node_modules/
**/dist/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr

# Kind and local runtime state
.kind_tmp/
*.pid
*.pid.fl
*.fl

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
platform/nexmesh.db*

# Archives and backup files
*.zip
*.tar.gz
*.backup
*.gpu-backup

# Client kits and participant runtime folders
client-kit/
client-kit*/
my-client-kit*/
*-kit/
*-kit*/
workspace/fedlearn/prod_*/
platform/backend/fedlearn/
workspace/fedlearn/state/
workspace/fedlearn/**/local/
workspace/fedlearn/**/startup/
workspace/fedlearn/**/transfer/
workspace/fedlearn/**/*.log
workspace/fedlearn/**/*.jsonl

# Private/raw datasets and generated model artifacts
dataset/
datasets/
mnist_raw/
workspace/fedlearn/mnist_raw/
workspace/fedlearn/datasets/
workspace/fedlearn/server_test/
workspace/fedlearn/results/
jobs/**/app/custom/raw_data/
**/*.pt
**/*.pth
**/*.ckpt

# Local experiment outputs & logs
results/
logs/
*.out
*.err
*.log
Amazon Q Logs.log

# Scratch and notes files
commit_msg.txt
final plan.md
further improvement
improvements
plan
working.md
prompt.md
reprovision.sh
Check_lines_99-101_in_resources_json_20261024.md
GPU_resource_allocation_for_MNIST_20261024.md
