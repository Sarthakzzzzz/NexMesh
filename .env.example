# Copy this file to .env and adjust the local paths.
FEDLEARN_ROOT=/path/to/fedlearn
KIND_TMPDIR=/path/to/fedlearn/.kind_tmp
KIND_CLUSTER_NAME=fedlearn-cluster
NVFLARE_IMAGE=fedlearn/nvflare:local

# IP or hostname remote clients use to reach NVFlare & Coordinator (e.g., Tailscale IP or LAN IP)
NEXMESH_SERVER_NAME=127.0.0.1
NEXMESH_COORDINATOR_URL=http://127.0.0.1:8000

# Authentication tokens
NEXMESH_HOST_TOKEN=changeme
NEXMESH_AGENT_TOKEN=agent-test
VITE_HOST_TOKEN=changeme
